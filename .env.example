# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=college-assistant-dev-secret-key-change-in-production

# Database (SQLite)
DATABASE_URI=sqlite:///instance/campus_assistant.db

# Optional AI Integration (Google Gemini API)
# Leave empty to run in 100% offline knowledge base / FAQ matching mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# College Contact Defaults (Used when answering inquiries or in fallback notices)
COLLEGE_NAME="CampusAI College of Arts, Science & Technology"
COLLEGE_EMAIL=admin@campusai.edu
COLLEGE_PHONE=+1-800-555-CAMPUS
COLLEGE_ADDRESS="100 University Avenue, Academic Hills, NY 10001"
COLLEGE_HOURS="Monday - Friday: 8:30 AM - 5:00 PM | Saturday: 9:00 AM - 1:00 PM"
